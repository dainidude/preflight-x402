PREFLIGHT_PAY_TO_ADDRESS=<your-receiving-wallet-address>
PREFLIGHT_NETWORK=base-sepolia
PREFLIGHT_FACILITATOR=https://x402.org/facilitator
PREFLIGHT_PORT=8000
DEV_MODE=0
FREE_TIER=1
PREFLIGHT_ATTEST_KEY=<generate-a-burner-key: openssl rand -hex 32>
CLIENT_PRIVATE_KEY=<generate-a-burner-key: openssl rand -hex 32>
PREFLIGHT_API_URL=http://127.0.0.1:8000
RPC_URL=https://sepolia.base.org
DISCORD_WEBHOOK_URL=<optional: discord webhook for sale notifications>
CDP_API_KEY_ID=<optional: portal.cdp.coinbase.com/api-keys/secret — enables CDP facilitator + Bazaar indexing>
CDP_API_KEY_SECRET=<the private key value from the downloaded API key JSON>
